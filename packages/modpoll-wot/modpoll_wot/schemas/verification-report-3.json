{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/top-maker/modpoll-wot/schemas/verification-report-3.json",
  "title": "Modbus hardware verification report",
  "description": "One reading of a Thing Model on a physical device, without endpoints, serial numbers or raw values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportVersion", "product", "model", "tool", "transport", "date", "points"],
  "properties": {
    "reportVersion": { "const": 3 },
    "product": { "$ref": "#/$defs/productId" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "fingerprint", "source"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fingerprint": { "type": "string", "pattern": "^mf1:[0-9a-f]{64}$" },
        "source": { "enum": ["catalog", "workspace", "local"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "catalog" } } },
          "then": {
            "required": ["ref"],
            "properties": { "ref": { "pattern": "^[0-9a-f]{40}$" } }
          }
        },
        {
          "if": { "properties": { "source": { "const": "workspace" } } },
          "then": { "required": ["ref"] }
        },
        {
          "if": { "properties": { "source": { "const": "local" } } },
          "then": {
            "not": { "required": ["ref"] }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "interpreter"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "version": { "$ref": "#/$defs/version" },
        "interpreter": { "$ref": "#/$defs/version" }
      }
    },
    "transport": { "enum": ["tcp", "rtu"] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chassis": { "$ref": "#/$defs/productId" },
        "firmware": { "type": "string", "minLength": 1, "maxLength": 64 },
        "configuration": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property", "fingerprint", "read", "expected"],
        "properties": {
          "property": { "type": "string", "minLength": 1, "maxLength": 128 },
          "fingerprint": { "type": "string", "pattern": "^pf1:[0-9a-f]{64}$" },
          "read": { "enum": ["ok", "exception", "no-response", "not-tested"] },
          "exceptionCode": { "type": "integer", "minimum": 1, "maximum": 255 },
          "expected": { "enum": ["confirmed", "rejected", "unchecked"] }
        },
        "allOf": [
          {
            "if": { "properties": { "read": { "const": "exception" } } },
            "then": { "required": ["exceptionCode"] },
            "else": { "not": { "required": ["exceptionCode"] } }
          },
          {
            "if": { "properties": { "read": { "not": { "const": "ok" } } } },
            "then": { "properties": { "expected": { "const": "unchecked" } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 129
    },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z.+-]{1,64}$" }
  }
}
